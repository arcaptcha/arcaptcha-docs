{
  "name": "arcaptcha-docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "prestart": "node scripts/generate-clean-markdown.js",
    "prestart:fa": "node scripts/generate-clean-markdown.js",
    "prestart:en": "node scripts/generate-clean-markdown.js",
    "start": "docusaurus start",
    "start:fa": "docusaurus start --locale fa",
    "start:en": "docusaurus start --locale en",
    "prebuild": "node scripts/generate-clean-markdown.js",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "pretest": "node scripts/generate-clean-markdown.js",
    "test": "node --test 'tests/*.test.js'",
    "generate:markdown": "node scripts/generate-clean-markdown.js",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "@svgr/webpack": "^8.1.0",
    "clsx": "^2.0.0",
    "file-loader": "^6.2.0",
    "prism-react-renderer": "^1.3.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "url-loader": "^4.1.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "docusaurus-prince-pdf": "github:signcl/docusaurus-prince-pdf#v1.2.2"
  }
}
